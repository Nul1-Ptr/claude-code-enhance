{
  "name": "claude-code-enhance",
  "displayName": "Claude Code Enhance",
  "description": "Improves Claude Code rich rendering and exposes complete sub-agent transcripts in VS Code.",
  "version": "1.0.5",
  "publisher": "AlexisHe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nul1-Ptr/claude-code-enhance.git"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "latex",
    "math",
    "mathematics",
    "equations",
    "katex",
    "claude",
    "claude-code",
    "anthropic",
    "agents",
    "transcripts",
    "markdown",
    "rendering"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:claude-code-enhance.subagents"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claude-code-enhance.enable",
        "title": "Claude Code Enhance: Enable"
      },
      {
        "command": "claude-code-enhance.disable",
        "title": "Claude Code Enhance: Disable"
      },
      {
        "command": "claude-code-enhance.status",
        "title": "Claude Code Enhance: Status"
      },
      {
        "command": "claude-code-enhance.diagnostics",
        "title": "Claude Code Enhance: Show Diagnostics"
      },
      {
        "command": "claude-code-enhance.openSubagentTranscripts",
        "title": "Claude Code Enhance: Open Sub-agent Sidebar"
      },
      {
        "command": "claude-code-enhance.openRawSubagentTranscript",
        "title": "Claude Code Enhance: Open Raw Sub-agent Transcript",
        "icon": "$(json)"
      },
      {
        "command": "claude-code-enhance.refreshSubagents",
        "title": "Claude Code Enhance: Refresh Sub-agents",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claude-code-enhance",
          "title": "Claude Code",
          "icon": "resources/subagents.svg"
        }
      ]
    },
    "views": {
      "claude-code-enhance": [
        {
          "id": "claude-code-enhance.subagents",
          "name": "Sub-agents",
          "contextualTitle": "Claude Code Sub-agents"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "claude-code-enhance.refreshSubagents",
          "when": "view == claude-code-enhance.subagents",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "claude-code-enhance.openRawSubagentTranscript",
          "when": "viewItem == subagentTranscript",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "Claude Code Enhance",
      "properties": {
        "claudeCodeEnhance.fullTranscript": {
          "type": "boolean",
          "default": true,
          "description": "Keep the full Claude conversation mounted instead of applying Claude Code's built-in retention cap. This can use substantial memory in very long sessions."
        },
        "claudeCodeEnhance.contentScale": {
          "type": "number",
          "default": 1.1,
          "minimum": 0.8,
          "maximum": 1.5,
          "description": "Base scale applied to rendered conversation content."
        },
        "claudeCodeEnhance.mathScale": {
          "type": "number",
          "default": 1.0,
          "minimum": 0.8,
          "maximum": 1.6,
          "description": "Additional scale applied to inline and display mathematics."
        },
        "claudeCodeEnhance.toolOutputMath": {
          "type": "boolean",
          "default": true,
          "description": "Render validated mathematics found in prose-oriented tool output while preserving code regions."
        },
        "claudeCodeEnhance.syntaxHighlighting": {
          "type": "boolean",
          "default": true,
          "description": "Apply bundled syntax highlighting to Claude Code output blocks."
        },
        "claudeCodeEnhance.copyButtons": {
          "type": "boolean",
          "default": true,
          "description": "Show copy controls for code blocks and assistant turns."
        },
        "claudeCodeEnhance.apiErrorCards": {
          "type": "boolean",
          "default": true,
          "description": "Present API errors as structured, theme-aware diagnostic cards."
        },
        "claudeCodeEnhance.subagentProjectsRoot": {
          "type": "string",
          "default": "",
          "description": "Root containing Claude Code project histories and sub-agent transcripts. Leave empty to use ~/.claude/projects."
        }
      }
    }
  },
  "scripts": {
    "test": "node scripts/smoke-test.js && node scripts/rich-content-regression.js && node scripts/architecture-regression.js && node scripts/subagent-regression.js",
    "test:smoke": "node scripts/smoke-test.js",
    "test:rich": "node scripts/rich-content-regression.js",
    "test:architecture": "node scripts/architecture-regression.js",
    "test:subagents": "node scripts/subagent-regression.js",
    "test:history": "node scripts/history-regression.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository",
    "restore": "node ./uninstall-hook.js",
    "vscode:uninstall": "node ./uninstall-hook.js"
  },
  "extensionDependencies": [
    "anthropic.claude-code"
  ],
  "author": ""
}
